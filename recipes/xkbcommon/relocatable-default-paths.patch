+/*
+ * cvcpkg: relocatable default paths.
+ *
+ * DFLT_XKB_CONFIG_ROOT, DFLT_XKB_CONFIG_EXTRA_PATH and XLOCALEDIR are absolute
+ * paths fixed at configure time, and the prefix they name does not exist once
+ * a cvcpkg bundle is installed somewhere else.  Resolve each one against the
+ * directory this library was loaded from instead, found with dladdr():
+ * <libdir>/../share/X11/xkb, <libdir>/../etc/xkb and
+ * <libdir>/../share/X11/locale.  A path is used only if it is a directory;
+ * otherwise the configure-time default applies.  XKB_CONFIG_ROOT,
+ * XKB_CONFIG_EXTRA_PATH and XLOCALEDIR still override both.
+ */
+static char *
+relocated_dir(const char *rel)
+{
+    Dl_info info;
+    const char *slash;
+    struct stat stat_buf;
+    char *path;
+
+    if (dladdr((void *) &relocated_dir, &info) == 0 || !info.dli_fname)
+        return NULL;
+    slash = strrchr(info.dli_fname, '/');
+    if (!slash)
+        return NULL;
+    path = asprintf_safe("%.*s/../%s", (int) (slash - info.dli_fname),
+                         info.dli_fname, rel);
+    if (path && (stat(path, &stat_buf) != 0 || !S_ISDIR(stat_buf.st_mode))) {
+        free(path);
+        path = NULL;
+    }
+    return path;
+}
+
