@@ -393,6 +393,14 @@ def _get_imports_ldd(filename, search_paths):
         # or
         #   /tmp/python/install/bin/../lib/libpython3.13.so.1.0 (0x00007b9489c82000)
         LDD_PATTERN = re.compile(r"^\s*(?:(.*?)\s+=>\s+)?(.*?)\s+\(.*\)")
+    elif compat.is_netbsd:
+        # Match libs of the form
+        #   -lname.major => full-path-to-lib
+        # e.g.
+        #   -lz.1 => /usr/lib/libz.so.1
+        # NetBSD's ldd prints no load address, so the default pattern below (which requires one) matches nothing and
