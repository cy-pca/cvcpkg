Link LLVM's component libraries where there is no LLVM shared library.

tools/llvm-cbe links the LLVM dylib target unconditionally under USE_SYSTEM_LLVM.
An MSVC LLVM build has no LLVM_BUILD_LLVM_DYLIB, so the Windows build failed
with LNK1181: cannot open input file 'LLVM.lib' (windows catch-up populate
2026-10-20).  Where the target exists (the Unix builds) nothing changes;
elsewhere link the components the in-tree build lists.

--- a/tools/llvm-cbe/CMakeLists.txt
+++ b/tools/llvm-cbe/CMakeLists.txt
@@ -35,7 +35,31 @@
     CBackendCodeGen
     CBackendInfo
     )
-  target_link_libraries(llvm-cbe
-    LLVM
-    ${llvm_libs})
+  # The LLVM shared library exists only where LLVM was built with
+  # LLVM_BUILD_LLVM_DYLIB; an MSVC build has none (LNK1181: cannot open input
+  # file 'LLVM.lib'), so link the components the in-tree build above lists.
+  if(TARGET LLVM)
+    target_link_libraries(llvm-cbe
+      LLVM
+      ${llvm_libs})
+  else()
+    llvm_map_components_to_libnames(llvm_component_libs
+      ${LLVM_TARGETS_TO_BUILD}
+      Analysis
+      AsmParser
+      AsmPrinter
+      BitReader
+      CodeGen
+      Core
+      IRReader
+      MC
+      ScalarOpts
+      SelectionDAG
+      Support
+      Target
+      )
+    target_link_libraries(llvm-cbe
+      ${llvm_libs}
+      ${llvm_component_libs})
+  endif()
 endif()
