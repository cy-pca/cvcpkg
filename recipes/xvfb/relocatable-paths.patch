 const char *XkbBinDirectory = XKB_BIN_DIRECTORY;
 static int XkbWantAccessX = 0;
 
+#ifdef __linux__
+/*
+ * cvcpkg: relocatable XKB paths.
+ *
+ * XKB_BASE_DIRECTORY / XKB_BIN_DIRECTORY are compile-time constants, which
+ * would pin the server to the (temporary) prefix it was built in.  When the
+ * server is installed as <prefix>/bin/Xvfb, prefer the XKB data and the
+ * xkbcomp binary that live in the same prefix:
+ *     <prefix>/bin/xkbcomp
+ *     <prefix>/share/X11/xkb/rules/evdev
+ * An explicit -xkbdir on the command line still overrides the base directory
+ * (it is processed later).  Skipped for setuid servers.
+ */
+static char xkb_reloc_bindir[PATH_MAX];
+static char xkb_reloc_basedir[PATH_MAX];
+
+static void __attribute__((constructor))
+XkbResolveRelocatableDirs(void)
+{
+    char exe[PATH_MAX], probe[PATH_MAX + 64], *slash;
+    ssize_t n;
+
+    if (getuid() != geteuid())
+        return;
+    n = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+    if (n <= 0)
+        return;
+    exe[n] = '\0';
+    slash = strrchr(exe, '/');
+    if (!slash)
+        return;
+    *slash = '\0';
+
+    if (snprintf(probe, sizeof(probe), "%s/xkbcomp", exe) < (int) sizeof(probe) &&
+        access(probe, X_OK) == 0) {
+        snprintf(xkb_reloc_bindir, sizeof(xkb_reloc_bindir), "%s", exe);
+        XkbBinDirectory = xkb_reloc_bindir;
+    }
+    if (snprintf(probe, sizeof(probe), "%s/../share/X11/xkb/rules/evdev",
+                 exe) < (int) sizeof(probe) && access(probe, R_OK) == 0) {
+        snprintf(xkb_reloc_basedir, sizeof(xkb_reloc_basedir),
+                 "%s/../share/X11/xkb", exe);
+        XkbBaseDirectory = xkb_reloc_basedir;
+    }
+}
+#endif /* __linux__ */
+
