diff --git a/src/pipewire/cvc-relocate.h b/src/pipewire/cvc-relocate.h
new file mode 100644
index 0000000..2df87df
--- /dev/null
+++ b/src/pipewire/cvc-relocate.h
@@ -0,0 +1,60 @@
+/* PipeWire */
+/* SPDX-License-Identifier: MIT */
+
+/*
+ * cvcpkg: relocatable install directories.
+ *
+ * cvcpkg builds PipeWire under an ephemeral sandbox prefix and relocates the
+ * package into each consumer's prefix, so the compiled-in PLUGINDIR,
+ * MODULEDIR and PIPEWIRE_CONFDATADIR are dead paths there: pw_init() found no
+ * SPA support plugin ("can't make support.system handle") and no client.conf.
+ * This resolves those directories relative to the shared object the calling
+ * code is compiled into instead, the way alsa-lib's dlmisc.c finds its
+ * plugins.  (PIPEWIRE_CONFIG_DIR, the administrator's overrides, is the
+ * system's /etc/pipewire: the recipe passes an absolute --sysconfdir.)
+ *
+ * Not installed; private to libpipewire and its modules.
+ */
+
+#ifndef PIPEWIRE_CVC_RELOCATE_H
+#define PIPEWIRE_CVC_RELOCATE_H
+
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * Returns <dir>/<rel>, where <dir> is the directory of the shared object this
+ * function is compiled into (it is static, so taking its address names the
+ * copy in the caller's object: libpipewire-0.3.so for the library, the module
+ * .so for a module), when that directory exists.  Otherwise returns
+ * fallback, normally the compiled-in path.  The result is cached in *cache
+ * for the process lifetime, like the getenv() strings it stands in for.
+ */
+static inline const char *pw_cvc_relocated_dir(const char *rel,
+		const char *fallback, char **cache)
+{
+	Dl_info info;
+	char object[PATH_MAX], path[PATH_MAX];
+	const char *result = fallback;
+	char *slash;
+
+	if (*cache != NULL)
+		return *cache;
+	if (dladdr((void *)pw_cvc_relocated_dir, &info) != 0 &&
+	    info.dli_fname != NULL &&
+	    realpath(info.dli_fname, object) != NULL &&
+	    (slash = strrchr(object, '/')) != NULL) {
+		*slash = '\0';
+		if ((size_t)snprintf(path, sizeof(path), "%s/%s", object, rel) < sizeof(path) &&
+		    access(path, X_OK) == 0)
+			result = path;
+	}
+	*cache = strdup(result);
+	return *cache != NULL ? *cache : fallback;
+}
+
+#endif /* PIPEWIRE_CVC_RELOCATE_H */
