diff --git a/src/conf.c b/src/conf.c
index b0dd629..e91698c 100644
--- a/src/conf.c
+++ b/src/conf.c
@@ -586,6 +586,58 @@ static void free_include_paths(struct filedesc *fd)
 
 #endif /* DOC_HIDDEN */
 
+/* cvcpkg: resolve the config tree relative to the loaded libasound.so (see
+ * snd_config_topdir() below), so a relocatable package finds alsa.conf next to
+ * the library instead of at the absolute --prefix baked in at build time. */
+#if defined(HAVE_LIBDL) && defined(__GLIBC__) && !defined(__UCLIBC__)
+#define DL_ORIGIN_AVAILABLE 1
+#endif
+
+#ifndef DOC_HIDDEN
+#ifdef DL_ORIGIN_AVAILABLE
+/*
+ * Derive the top-level config directory from the directory of the loaded
+ * libasound.so, instead of the absolute --prefix baked into ALSA_CONFIG_DIR at
+ * build time.
+ *
+ * cvcpkg builds under an ephemeral sandbox prefix and relocates the package
+ * into each consumer's prefix, so the compiled-in ALSA_CONFIG_DIR (e.g.
+ * /tmp/cvcpkg-builder/.../install/share/alsa) is a dead path on the consumer
+ * and snd_config_update_r() fails with "Cannot access file .../alsa.conf".
+ * libasound installs at <prefix>/lib/libasound.so.2 with its config tree at
+ * <prefix>/share/alsa, so <origin>/../share/alsa points back at it wherever the
+ * prefix lands.  This mirrors snd_dlinfo_origin() in dlmisc.c, which already
+ * derives the plugin dir from the .so origin the same way.
+ *
+ * Returns a malloc'd path when the derived directory actually holds an
+ * alsa.conf, else NULL so the caller keeps the compiled-in default -- this both
+ * preserves normal system-install behaviour and avoids hijacking an unrelated
+ * sibling directory.  The result is cached by the caller for process lifetime
+ * (never freed), exactly like the getenv()/compiled-in paths it replaces.
+ */
+static char *snd_config_topdir_origin(void)
+{
+	struct link_map *links;
+	Dl_info info;
+	char origin[PATH_MAX];
+	char path[PATH_MAX];
+	char probe[PATH_MAX];
+
+	if (dladdr1(&snd_config_topdir_origin, &info, (void **)&links, RTLD_DL_LINKMAP) == 0)
+		return NULL;
+	if (dlinfo(links, RTLD_DI_ORIGIN, origin))
+		return NULL;
+	if ((size_t)snprintf(path, sizeof(path), "%s/../share/alsa", origin) >= sizeof(path))
+		return NULL;
+	if ((size_t)snprintf(probe, sizeof(probe), "%s/alsa.conf", path) >= sizeof(probe))
+		return NULL;
+	if (access(probe, R_OK) != 0)
+		return NULL;
+	return strdup(path);
+}
+#endif /* DL_ORIGIN_AVAILABLE */
+#endif /* DOC_HIDDEN */
+
 /**
  * \brief Returns the default top-level config directory
  * \return The top-level config directory path string
@@ -601,8 +653,16 @@ const char *snd_config_topdir(void)
 
 	if (!topdir) {
 		topdir = getenv("ALSA_CONFIG_DIR");
-		if (!topdir || *topdir != '/' || strlen(topdir) >= PATH_MAX)
-			topdir = ALSA_CONFIG_DIR;
+		if (!topdir || *topdir != '/' || strlen(topdir) >= PATH_MAX) {
+			topdir = NULL;
+#ifdef DL_ORIGIN_AVAILABLE
+			/* cvcpkg: prefer a path relative to libasound.so's own
+			 * location, so a relocated package finds its config tree. */
+			topdir = snd_config_topdir_origin();
+#endif
+			if (!topdir)
+				topdir = ALSA_CONFIG_DIR;
+		}
 	}
 	return topdir;
 }
