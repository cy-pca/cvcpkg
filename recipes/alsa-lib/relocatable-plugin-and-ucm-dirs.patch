+/* cvcpkg: the distribution's plugin directory for this architecture, using
+ * Debian's multiarch tuple names. */
+#if defined(__x86_64__) && defined(__LP64__)
+#define SND_MULTIARCH "x86_64-linux-gnu"
+#elif defined(__aarch64__)
+#define SND_MULTIARCH "aarch64-linux-gnu"
+#elif defined(__i386__)
+#define SND_MULTIARCH "i386-linux-gnu"
+#elif defined(__arm__) && defined(__ARM_PCS_VFP)
+#define SND_MULTIARCH "arm-linux-gnueabihf"
+#elif defined(__powerpc64__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+#define SND_MULTIARCH "powerpc64le-linux-gnu"
+#elif defined(__riscv) && __riscv_xlen == 64
+#define SND_MULTIARCH "riscv64-linux-gnu"
+#elif defined(__s390x__)
+#define SND_MULTIARCH "s390x-linux-gnu"
+#endif
+
+/*
+ * cvcpkg builds libasound under an ephemeral sandbox prefix and relocates the
+ * package, so the compiled-in ALSA_PLUGIN_DIR is a dead path and the package
+ * ships no <origin>/alsa-lib of its own.  The configuration it reads includes
+ * the system's /etc/alsa/conf.d, which names the distribution's plugins
+ * (pipewire, pulse, jack, rate converters, ...) by type only, so look for them
+ * in the distribution's plugin directory: Debian multiarch first, then
+ * lib64 (Fedora, openSUSE), then lib (Arch, Alpine, 32-bit systems).  A
+ * system libasound loads its plugins from <origin>/alsa-lib above, so this
+ * changes nothing for a system install.
+ */
+static void snd_dlinfo_system(void)
+{
+	static const char *const dirs[] = {
+#ifdef SND_MULTIARCH
+		"/usr/lib/" SND_MULTIARCH "/alsa-lib",
+#endif
+#if defined(__LP64__)
+		"/usr/lib64/alsa-lib",
+#endif
+		"/usr/lib/alsa-lib",
+	};
+	size_t i;
+
+	for (i = 0; i < sizeof(dirs) / sizeof(dirs[0]); i++) {
+		if (access(dirs[i], X_OK) == 0) {
+			snd_plugin_dir = strdup(dirs[i]);
+			return;
+		}
+	}
+}
+
 /**
  *
  * \brief Compose the dynamic path
@@ -96,6 +146,8 @@ int snd_dlpath(char *path, size_t path_len, const char *name)
 			snd_plugin_dir = strdup(env);
 		} else {
 			snd_dlinfo_origin(path, path_len);
+			if (!snd_plugin_dir)
+				snd_dlinfo_system();
 		}
 		snd_plugin_dir_set = 1;
 	}
