+/*
+ * cvcpkg: the default UCM directory, <topdir>/<name>, where topdir is
+ * snd_config_topdir() (ALSA_CONFIG_DIR from the environment, or the config
+ * tree next to the loaded libasound.so), instead of the compiled-in
+ * ALSA_CONFIG_DIR, which is the dead build sandbox prefix of a relocated
+ * package.  The package does not ship the UCM profiles (alsa-ucm-conf), so
+ * when <topdir>/<name> is missing, use the system's /usr/share/alsa/<name>.
+ * The result is cached for the process lifetime, like snd_config_topdir().
+ * parser.c's ucm_filename() and uc_mgr_scan_master_configs() use this too,
+ * where upstream builds <topdir>/ucm2 itself.
+ */
+static const char *uc_mgr_default_config_dir(const char *name,
+					     const char *fallback, char **cache)
+{
+	char path[PATH_MAX];
+	char system_path[PATH_MAX];
+
+	if (*cache)
+		return *cache;
+	snprintf(path, sizeof(path), "%s/%s", snd_config_topdir(), name);
+	if (access(path, R_OK) != 0) {
+		snprintf(system_path, sizeof(system_path), "/usr/share/alsa/%s", name);
+		if (access(system_path, R_OK) == 0)
+			snd_strlcpy(path, system_path, sizeof(path));
+	}
+	*cache = strdup(path);
+	return *cache ? *cache : fallback;
+}
+
 const char *uc_mgr_config_dir(int format)
 {
+	static char *ucm_dir, *ucm2_dir;
 	const char *path;
 
 	if (format >= 2) {
 		path = getenv(ALSA_CONFIG_UCM2_VAR);
 		if (!path || path[0] == '\0')
-			path = ALSA_CONFIG_DIR "/ucm2";
+			path = uc_mgr_default_config_dir("ucm2",
+					ALSA_CONFIG_DIR "/ucm2", &ucm2_dir);
 	} else {
 		path = getenv(ALSA_CONFIG_UCM_VAR);
 		if (!path || path[0] == '\0')
-			path = ALSA_CONFIG_DIR "/ucm";
+			path = uc_mgr_default_config_dir("ucm",
+					ALSA_CONFIG_DIR "/ucm", &ucm_dir);
 	}
 	return path;
 }
