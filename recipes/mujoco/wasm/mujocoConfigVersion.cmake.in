# mujocoConfigVersion.cmake — written by cvcpkg's mujoco recipe for the wasm
# bundle.  Same rule upstream's native package uses (AnyNewerVersion): any
# request for a version <= @MUJOCO_VERSION@ is satisfied.
set(PACKAGE_VERSION "@MUJOCO_VERSION@")
if(PACKAGE_FIND_VERSION VERSION_GREATER PACKAGE_VERSION)
  set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
  set(PACKAGE_VERSION_COMPATIBLE TRUE)
  if(PACKAGE_FIND_VERSION STREQUAL PACKAGE_VERSION)
    set(PACKAGE_VERSION_EXACT TRUE)
  endif()
endif()
