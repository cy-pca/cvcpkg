+def _get_imports_haiku(filename, search_paths):
+    """Haiku helper for `get_imports`. Haiku ships no `ldd`, so read the
+    DT_NEEDED entries via `readelf -d` and resolve them against
+    runtime_loader's search path (LIBRARY_PATH first, then system libs)."""
+    output = set()
+    try:
+        p = subprocess.run(
+            ['readelf', '-d', os.path.realpath(filename)],
+            stdin=subprocess.DEVNULL, stderr=subprocess.PIPE,
+            stdout=subprocess.PIPE, encoding='utf-8',
+        )
+    except FileNotFoundError:
+        logger.warning("readelf not found; cannot resolve imports of %r", filename)
+        return output
+    lib_dirs = [d for d in os.environ.get('LIBRARY_PATH', '').split(os.pathsep) if d]
+    if search_paths:
+        lib_dirs.extend(search_paths)
+    lib_dirs.extend([
+        '/boot/home/config/non-packaged/lib',
+        '/boot/system/non-packaged/lib',
+        '/boot/system/develop/lib',
+        '/boot/system/lib',
+    ])
+    for line in p.stdout.splitlines():
+        if '(NEEDED)' not in line or '[' not in line or ']' not in line:
+            continue
+        name = line[line.index('[') + 1:line.index(']')]
+        lib = None
+        for d in lib_dirs:
+            cand = os.path.join(d, name)
+            if os.path.isfile(cand):
+                lib = os.path.realpath(cand)
+                break
+        output.add((name, lib))
+    return output
+
