diff --git a/bootloader/src/pyi_dylib_python.c b/bootloader/src/pyi_dylib_python.c
index 0ae1da4..9a8100e 100644
--- a/bootloader/src/pyi_dylib_python.c
+++ b/bootloader/src/pyi_dylib_python.c
@@ -121,6 +121,43 @@ static int _pyi_dylib_python_load_library(
 #endif /* defined(_WIN32) */
 
 
+#if defined(__NetBSD__)
+
+/*
+ * NetBSD 10's ld.elf_so takes the fast path of __tls_get_addr() only for
+ * `idx < DTV_MAX_INDEX(dtv)`, so the module with the HIGHEST TLS index
+ * (`idx == DTV_MAX_INDEX`) goes through _rtld_tls_get_addr() on every access:
+ * a sigprocmask() pair and an _lwp_self() under the loader's exclusive lock.
+ * The Python shared library is that module whenever it is dlopen()ed, as it is
+ * here: it is mapped after every library the bootloader links, and CPython 3.12
+ * reads its thread state from a thread-local variable on almost every call, so
+ * a frozen application runs 20-100x slower than the same code under the
+ * `python3` executable (which links libpython at start-up, so libc's or
+ * libpthread's module ends up above it).  Fixed upstream in tls.c 1.34
+ * (`idx <= DTV_MAX_INDEX`), which no NetBSD 10 release carries.
+ *
+ * Mapping any other module with a TLS segment after libpython raises the
+ * maximum index past it, so libpython's own accesses take the fast path again;
+ * libpyi_tlspad.so (bootloader/tlspad/) is such a module, collected next to
+ * libpython by Analysis.  A missing pad only costs speed.
+ */
+static void _pyi_dylib_python_netbsd_tls_pad(const char *root_directory)
+{
+    char pad_fullpath[PYI_PATH_MAX];
+
+    if (snprintf(pad_fullpath, PYI_PATH_MAX, "%s/%s", root_directory, "libpyi_tlspad.so") >= PYI_PATH_MAX) {
+        return;
+    }
+    if (dlopen(pad_fullpath, RTLD_NOW | RTLD_LOCAL) == NULL) {
+        PYI_DEBUG("DYLIB: could not load TLS pad library %s: %s\n", pad_fullpath, dlerror());
+        return;
+    }
+    PYI_DEBUG("DYLIB: loaded TLS pad library %s\n", pad_fullpath);
+}
+
+#endif /* defined(__NetBSD__) */
+
+
 /* Import symbols from the loaded shared library */
 static int _pyi_dylib_python_import_symbols(struct DYLIB_PYTHON *dylib)
 {
@@ -252,6 +289,10 @@ struct DYLIB_PYTHON *pyi_dylib_python_load(const char *root_directory, const cha
     }
     PYI_DEBUG("DYLIB: loaded Python shared library.\n");
 
