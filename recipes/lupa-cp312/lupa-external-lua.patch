+def get_lua_builds_from_environment():
+    """Build one extension module per installed Lua named in $LUPA_EXTERNAL_LUA.
+
+    (cvcpkg addition.)  The value is a JSON object mapping a module name to the
+    Lua installation it links against, e.g.
+
+        {"lua54":    {"include_dirs": ["/p/include"],
+                      "library_dirs": ["/p/lib"], "libraries": ["lua"]},
+         "luajit21": {"include_dirs": ["/p/include/luajit-2.1"],
+                      "library_dirs": ["/p/lib"], "libraries": ["luajit-5.1"]}}
+
+    which yields lupa.lua54 and lupa.luajit21 -- the module names a bundled
+    build produces -- linked against those installed (shared) libraries
+    instead of compiling the Lua sources bundled in third-party/.
+    """
+    spec = os.environ.get('LUPA_EXTERNAL_LUA')
+    if not spec:
+        return []
+    import json
+    configs = []
+    for module_name, cfg in json.loads(spec).items():
+        print("Using external Lua for lupa.%s: %s" % (module_name, cfg))
+        configs.append(dict(
+            libversion=module_name,
+            include_dirs=cfg.get('include_dirs', []),
+            library_dirs=cfg.get('library_dirs', []),
+            libraries=cfg.get('libraries', []),
+        ))
+    return configs
+
+
