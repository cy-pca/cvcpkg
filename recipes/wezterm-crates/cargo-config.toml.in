# cargo source replacement for the wezterm-crates crate set (docs/rust-crates.md).
# Generated by tools/make_crate_packages.py. A consumer replaces @CRATES_DIR@
# with <build prefix>/share/cargo/crates and builds with --offline --locked.

[source.crates-io]
replace-with = "cvcpkg-crates"

[source."git+https://github.com/wez/xcb-imdkit-rs.git?rev=215ce4b08ac9c4822e541efd4f4ffb1062806051"]
git = "https://github.com/wez/xcb-imdkit-rs.git"
rev = "215ce4b08ac9c4822e541efd4f4ffb1062806051"
replace-with = "cvcpkg-crates"

[source.cvcpkg-crates]
directory = "@CRATES_DIR@"
