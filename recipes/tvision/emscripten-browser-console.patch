+#ifndef TVISION_BROWSERCON_H
+#define TVISION_BROWSERCON_H
+
+// The console of a WebAssembly build that runs in a browser page (Emscripten). The page is a
+// terminal emulator (e.g. xterm.js) wired to the module's stdin and stdout: every byte it produces
+// (keys, mouse reports) arrives on stdin, and everything written to stdout is drawn. There is no
+// ncurses and no select(): output is plain ANSI through AnsiScreenWriter, input is decoded by
+// TermIO plus a table for the control characters, and the page reports its size through
+// tvision_set_screen_size(cols, rows).
+
+#ifdef __EMSCRIPTEN__
+
+#include <internal/platform.h>
+#include <internal/termio.h>
+#include <internal/ansiwrit.h>
+
+namespace tvision
+{
+
+class ConsoleCtl;
+
+// Reads stdin without blocking: a byte, or -1 when the page has none queued.
+struct BrowserInputGetter final : public InputGetter
+{
+    enum { maxPending = 64 };
+    int pending[maxPending];
+    int pendingCount {0};
+
+    int get() noexcept override;
+    void unget(int k) noexcept override;
+    bool peek() noexcept;
+};
+
+class BrowserInput final : public InputAdapter
+{
+    ConsoleCtl &con;
+    InputState &state;
+    BrowserInputGetter in;
+
+public:
+
+    // Lifetimes of 'con' and 'state' must exceed that of 'this'.
+    BrowserInput(ConsoleCtl &con, InputState &state) noexcept;
+    ~BrowserInput();
+
+    bool getEvent(TEvent &ev) noexcept override;
+    bool hasPendingEvents() noexcept override;
+};
+
+class BrowserDisplay final : public DisplayAdapter
+{
+    ConsoleCtl &con;
+    AnsiScreenWriter ansiScreenWriter;
+
+public:
+
+    BrowserDisplay(ConsoleCtl &con) noexcept;
+    ~BrowserDisplay();
+
+    TPoint reloadScreenInfo() noexcept override;
+    int getColorCount() noexcept override;
+    TPoint getFontSize() noexcept override;
+    void writeCell(TPoint, TStringView, TColorAttr, bool) noexcept override;
+    void setCaretPosition(TPoint) noexcept override;
+    void setCaretSize(int) noexcept override;
+    void clearScreen() noexcept override;
+    void flush() noexcept override;
+};
+
+// cmScreenChanged when the page reports a new size.
+class BrowserResizeSource final : public EventSource
+{
+public:
+
+    BrowserResizeSource() noexcept : EventSource(-1) {}
+
+    bool hasPendingEvents() noexcept override;
+    bool getEvent(TEvent &ev) noexcept override;
+};
+
+class BrowserConsoleAdapter final : public ConsoleAdapter
+{
+    InputAdapter &input;
+    BrowserResizeSource &resize;
+    InputState &inputState;
+
+    BrowserConsoleAdapter( DisplayAdapter &, InputAdapter &, BrowserResizeSource &,
+                           InputState & ) noexcept;
+
+public:
+
+    // The lifetime of 'con' must exceed that of the returned object.
+    static BrowserConsoleAdapter &create(ConsoleCtl &con) noexcept;
+    ~BrowserConsoleAdapter();
+};
+
+// The size the page last reported (80x24 until it does).
+TPoint browserScreenSize() noexcept;
+
+} // namespace tvision
+
+#endif // __EMSCRIPTEN__
+
+#endif // TVISION_BROWSERCON_H
