+#ifdef __EMSCRIPTEN__
+
+void EventWaiter::pollSources(int timeoutMs) noexcept
+// In a browser there is nothing to select() on, and blocking would freeze the page. Ask each
+// source whether it has an event, and between asks give the page the thread (emscripten_sleep,
+// which needs the module linked with -sASYNCIFY) so it can deliver input, until one has an event
+// or the time is up.
+{
+    const auto end = timeoutMs < 0 ? time_point::max()
+                                   : steady_clock::now() + milliseconds(timeoutMs);
+    for (;;)
+    {
+        bool hasEvents = false;
+        for (size_t i = 0; i < pd.size(); ++i)
+            if ((pd.states[i] = sources[i]->hasPendingEvents() ? psReady : psNothing))
+                hasEvents = true;
+        if (hasEvents || timeoutMs == 0)
+            return;
+        auto now = steady_clock::now();
+        if (now >= end)
+            return;
+        long long sliceMs = 8;
+        if (end != time_point::max())
+        {
+            long long left = duration_cast<milliseconds>(end - now).count() + 1;
+            if (left < sliceMs)
+                sliceMs = left;
+        }
+        emscripten_sleep((unsigned) sliceMs);
+    }
+}
