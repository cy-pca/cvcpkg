+#ifdef __EMSCRIPTEN__
+
+#define Uses_TKeys
+#define Uses_TEvent
+#define Uses_TPoint
+#define Uses_TScreen
+#include <tvision/tv.h>
+
+#include <internal/browsercon.h>
+#include <internal/conctl.h>
+#include <internal/codepage.h>
+#include <internal/utf8.h>
+
+#include <emscripten/emscripten.h>
+#include <unistd.h>
+
+namespace tvision
+{
+
+/////////////////////////////////////////////////////////////////////////
+// The page's size
+
+static TPoint screenSize {80, 24};
+static bool screenResized {false};
+
+TPoint browserScreenSize() noexcept
+{
+    return screenSize;
+}
+
+} // namespace tvision
+
+// The page calls this with the terminal's size: once before the program starts, and on every
+// resize. Exported so the page can reach it as Module._tvision_set_screen_size.
+extern "C" EMSCRIPTEN_KEEPALIVE void tvision_set_screen_size(int cols, int rows)
+{
+    using namespace tvision;
+    if (cols > 0 && rows > 0 && (cols != screenSize.x || rows != screenSize.y))
+    {
+        screenSize = {cols, rows};
+        screenResized = true;
+    }
+}
+
+namespace tvision
+{
+
+/////////////////////////////////////////////////////////////////////////
+// Input
+
+int BrowserInputGetter::get() noexcept
+{
+    if (pendingCount > 0)
+        return pending[--pendingCount];
+    unsigned char c;
+    // The page's stdin hands out one queued byte per call and reports none (EOF) when it has
+    // nothing, so this never blocks.
+    if (::read(STDIN_FILENO, &c, 1) == 1)
+        return c;
+    return -1;
+}
+
+void BrowserInputGetter::unget(int k) noexcept
+{
+    if (pendingCount < maxPending)
+        pending[pendingCount++] = k;
+}
+
+bool BrowserInputGetter::peek() noexcept
+{
+    if (pendingCount > 0)
+        return true;
+    int k = get();
+    if (k == -1)
+        return false;
+    unget(k);
+    return true;
+}
+
+static constexpr KeyDownEvent fromNonPrintableAscii[32] =
+{
+    {{'@'},         kbLeftCtrl, {'@'}, 1}, // ^@, Null
+    {{kbCtrlA},     kbLeftCtrl},
+    {{kbCtrlB},     kbLeftCtrl},
+    {{kbCtrlC},     kbLeftCtrl},
+    {{kbCtrlD},     kbLeftCtrl},
+    {{kbCtrlE},     kbLeftCtrl},
+    {{kbCtrlF},     kbLeftCtrl},
+    {{kbCtrlG},     kbLeftCtrl},
+    {{kbBack},      0}, // ^H, Backspace
+    {{kbTab},       0}, // ^I, Tab
+    {{kbEnter},     0}, // ^J, Line Feed
+    {{kbCtrlK},     kbLeftCtrl},
+    {{kbCtrlL},     kbLeftCtrl},
+    {{kbEnter},     0}, // ^M, Carriage Return
+    {{kbCtrlN},     kbLeftCtrl},
+    {{kbCtrlO},     kbLeftCtrl},
+    {{kbCtrlP},     kbLeftCtrl},
+    {{kbCtrlQ},     kbLeftCtrl},
+    {{kbCtrlR},     kbLeftCtrl},
+    {{kbCtrlS},     kbLeftCtrl},
+    {{kbCtrlT},     kbLeftCtrl},
+    {{kbCtrlU},     kbLeftCtrl},
+    {{kbCtrlV},     kbLeftCtrl},
+    {{kbCtrlW},     kbLeftCtrl},
+    {{kbCtrlX},     kbLeftCtrl},
+    {{kbCtrlY},     kbLeftCtrl},
+    {{kbCtrlZ},     kbLeftCtrl},
+    {{kbEsc},       0}, // ^[, Escape
+    {{'\\'},        kbLeftCtrl, {'\\'}, 1}, // ^\, File Separator
+    {{']'},         kbLeftCtrl, {']'}, 1}, // ^], Group Separator
+    {{'^'},         kbLeftCtrl, {'^'}, 1}, // ^^, Record Separator
+    {{'_'},         kbLeftCtrl, {'_'}, 1}, // ^_, Unit Separator
+};
+
+BrowserInput::BrowserInput(ConsoleCtl &aCon, InputState &aState) noexcept :
+    InputAdapter(-1),
+    con(aCon),
+    state(aState)
+{
+    TStringView seq = "\x1B[?1000h" // Enable mouse reporting.
+                      "\x1B[?1002h" // Enable mouse drag reporting.
+                      "\x1B[?1006h" // Enable SGR extended mouse reporting.
+                      "\x1B[?2004h" // Enable bracketed paste.
+                    ;
+    con.write(seq.data(), seq.size());
+}
+
+BrowserInput::~BrowserInput()
+{
+    TStringView seq = "\x1B[?2004l"
+                      "\x1B[?1006l"
+                      "\x1B[?1002l"
+                      "\x1B[?1000l"
+                    ;
+    con.write(seq.data(), seq.size());
+}
+
+bool BrowserInput::hasPendingEvents() noexcept
+{
+    return in.peek();
+}
+
+bool BrowserInput::getEvent(TEvent &ev) noexcept
+{
+    // Escape sequences (cursor and function keys, SGR mouse, bracketed paste) first.
+    GetChBuf buf(in);
+    switch (TermIO::parseEvent(buf, ev, state))
+    {
+        case Rejected: buf.reject(); break;
+        case Accepted: return true;
+        case Ignored: return false;
+    }
+
+    int k = in.get();
+    if (k == -1)
+        return false;
+
+    ev.what = evKeyDown;
+    ev.keyDown = {};
+    bool alt = false;
+    // ESC followed by another byte is Alt+that key; a lone ESC is Escape. The page delivers a key's
+    // bytes together, so there is no need to wait for more.
+    if (k == '\x1B')
+    {
+        int next = in.get();
+        if (next != -1)
+        {
+            k = next;
+            alt = true;
+        }
+    }
+
+    if (k < 32)
+        ev.keyDown = fromNonPrintableAscii[k];
+    else if (k == 127)
+        ev.keyDown = {{kbBack}, 0}; // ^?, Delete
+    else
+    {
+        // A Unicode character: its UTF-8 bytes arrive one after another.
+        char text[4] = {(char) k};
+        int n = 1 + (int) Utf8BytesLeft((char) k);
+        for (int i = 1; i < n && i < 4; ++i)
+        {
+            int b = in.get();
+            if (b == -1)
+            {
+                n = i;
+                break;
+            }
+            text[i] = (char) b;
+        }
+        if (n > 4)
+            n = 4;
+        for (int i = 0; i < n; ++i)
+            ev.keyDown.text[i] = text[i];
+        ev.keyDown.textLength = (uchar) n;
+        ev.keyDown.charScan.charCode = CpTranslator::fromUtf8({ev.keyDown.text, size_t(n)});
+        // Prevent text from triggering Ctrl+Key shortcuts.
+        if (ev.keyDown.keyCode <= kbCtrlZ)
+            ev.keyDown.keyCode = kbNoKey;
+    }
+
+    if (alt)
+    {
+        ev.keyDown.controlKeyState |= kbLeftAlt;
+        TermIO::normalizeKey(ev.keyDown);
+    }
+    if (state.bracketedPaste)
+        ev.keyDown.controlKeyState |= kbPaste;
+
+    return ev.keyDown.keyCode != kbNoKey || ev.keyDown.textLength;
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Display
+
+BrowserDisplay::BrowserDisplay(ConsoleCtl &aCon) noexcept :
+    con(aCon),
+    ansiScreenWriter(aCon, TermCap {Direct, 0})
+{
+    TStringView seq = "\x1B[?1049h" // Alternate screen.
+                      "\x1B[H\x1B[2J";
+    con.write(seq.data(), seq.size());
+}
+
+BrowserDisplay::~BrowserDisplay()
+{
+    ansiScreenWriter.flush();
+    TStringView seq = "\x1B[0m\x1B[?25h\x1B[?1049l";
+    con.write(seq.data(), seq.size());
+}
+
+TPoint BrowserDisplay::reloadScreenInfo() noexcept
+{
+    ansiScreenWriter.reset();
+    return browserScreenSize();
+}
+
+int BrowserDisplay::getColorCount() noexcept
+{
+    return 256*256*256;
+}
+
+TPoint BrowserDisplay::getFontSize() noexcept
+{
+    return {0, 0};
+}
+
+void BrowserDisplay::writeCell(TPoint pos, TStringView text, TColorAttr attr, bool doubleWidth) noexcept
+{
+    ansiScreenWriter.writeCell(pos, text, attr, doubleWidth);
+}
+
+void BrowserDisplay::setCaretPosition(TPoint pos) noexcept
+{
+    ansiScreenWriter.setCaretPosition(pos);
+}
+
+void BrowserDisplay::setCaretSize(int size) noexcept
+{
+    ansiScreenWriter.flush();
+    TStringView seq = size > 0 ? "\x1B[?25h" : "\x1B[?25l";
+    con.write(seq.data(), seq.size());
+}
+
+void BrowserDisplay::clearScreen() noexcept
+{
+    ansiScreenWriter.clearScreen();
+}
+
+void BrowserDisplay::flush() noexcept
+{
+    ansiScreenWriter.flush();
+    // The page writes to its terminal once per frame, at a NUL: the same convention as FTXUI's
+    // Emscripten screen, since Emscripten has no flush hook. Terminals ignore NUL.
+    con.write("", 1);
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Resize
+
+bool BrowserResizeSource::hasPendingEvents() noexcept
+{
+    return screenResized;
+}
+
+bool BrowserResizeSource::getEvent(TEvent &ev) noexcept
+{
+    if (!screenResized)
+        return false;
+    screenResized = false;
+    ev.what = evCommand;
+    ev.message.command = cmScreenChanged;
+    return true;
+}
+
+/////////////////////////////////////////////////////////////////////////
+// Console
+
+inline BrowserConsoleAdapter::BrowserConsoleAdapter( DisplayAdapter &aDisplay,
+                                                     InputAdapter &aInput,
+                                                     BrowserResizeSource &aResize,
+                                                     InputState &aInputState ) noexcept :
+    ConsoleAdapter(aDisplay, {&aInput, &aResize}),
+    input(aInput),
+    resize(aResize),
+    inputState(aInputState)
+{
+}
+
+BrowserConsoleAdapter &BrowserConsoleAdapter::create(ConsoleCtl &con) noexcept
+{
+    auto &inputState = *new InputState;
+    auto &display = *new BrowserDisplay(con);
+    auto &input = *new BrowserInput(con, inputState);
+    auto &resize = *new BrowserResizeSource;
+    return *new BrowserConsoleAdapter(display, input, resize, inputState);
+}
+
+BrowserConsoleAdapter::~BrowserConsoleAdapter()
+{
+    delete &resize;
+    delete &input;
+    delete &display;
+    delete &inputState;
+}
+
+} // namespace tvision
+
+#endif // __EMSCRIPTEN__
