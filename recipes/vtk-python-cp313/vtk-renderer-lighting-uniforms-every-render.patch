diff --git a/Rendering/OpenGL2/Testing/Cxx/TestLightingUniformsEveryRender.cxx b/Rendering/OpenGL2/Testing/Cxx/TestLightingUniformsEveryRender.cxx
new file mode 100644
index 0000000..17a79be
--- /dev/null
+++ b/Rendering/OpenGL2/Testing/Cxx/TestLightingUniformsEveryRender.cxx
@@ -0,0 +1,178 @@
+// SPDX-FileCopyrightText: Copyright (c) Ken Martin, Will Schroeder, Bill Lorensen
+// SPDX-License-Identifier: BSD-3-Clause
+
+// Two renderers of one render window draw a sphere each, lit by one
+// directional light: from the left in the left renderer, from the right in the
+// right one. Both spheres are drawn with the same shader program. With
+// vtkOpenGLRenderer::UpdateLightingUniformsEveryRender on, each renderer must
+// draw its sphere as it does when it is the only renderer that draws.
+//
+// With it off, the renderer whose light was modified first draws its sphere
+// with the other renderer's light: here the left sphere is lit from the right,
+// from the first render with both renderers on.
+
+#include "vtkActor.h"
+#include "vtkCamera.h"
+#include "vtkLight.h"
+#include "vtkNew.h"
+#include "vtkOpenGLRenderer.h"
+#include "vtkPolyDataMapper.h"
+#include "vtkRenderWindow.h"
+#include "vtkSphereSource.h"
+#include "vtkUnsignedCharArray.h"
+
+#include <cstdlib>
+#include <iostream>
+
+namespace
+{
+// Two viewports of ViewportWidth x Height pixels, side by side.
+constexpr int ViewportWidth = 200;
+constexpr int Height = 200;
+
+struct Side
+{
+  vtkNew<vtkOpenGLRenderer> Renderer;
+  vtkNew<vtkLight> Light;
+  int X0 = 0; // the viewport's first pixel column
+};
+
+void ReadViewport(vtkRenderWindow* window, const Side& side, vtkUnsignedCharArray* pixels)
+{
+  window->GetPixelData(side.X0, 0, side.X0 + ViewportWidth - 1, Height - 1, 0, pixels);
+}
+
+// The mean of R, G and B over the left or the right half of a viewport.
+double MeanBrightness(vtkUnsignedCharArray* pixels, bool leftHalf)
+{
+  double sum = 0.0;
+  const int x0 = leftHalf ? 0 : ViewportWidth / 2;
+  for (int y = 0; y < Height; ++y)
+  {
+    for (int x = x0; x < x0 + ViewportWidth / 2; ++x)
+    {
+      for (int c = 0; c < 3; ++c)
+      {
+        sum += pixels->GetValue(3 * (y * ViewportWidth + x) + c);
+      }
+    }
+  }
+  return sum / (3.0 * Height * (ViewportWidth / 2));
+}
+
+// The number of pixels with a channel that differs by more than 8.
+int CountDifferentPixels(vtkUnsignedCharArray* a, vtkUnsignedCharArray* b)
+{
+  int count = 0;
+  for (vtkIdType p = 0; p < a->GetNumberOfTuples(); ++p)
+  {
+    for (int c = 0; c < 3; ++c)
+    {
+      if (std::abs(static_cast<int>(a->GetValue(3 * p + c)) -
+            static_cast<int>(b->GetValue(3 * p + c))) > 8)
+      {
+        ++count;
+        break;
+      }
+    }
+  }
+  return count;
+}
+
+// Returns true when each renderer draws as it does alone.
+bool DrawAsAlone(bool everyRender)
+{
+  vtkNew<vtkRenderWindow> window;
+  window->SetSize(2 * ViewportWidth, Height);
+  window->SetMultiSamples(0);
+
+  vtkNew<vtkSphereSource> sphere;
+  sphere->SetThetaResolution(48);
+  sphere->SetPhiResolution(48);
+
+  Side sides[2];
+  for (int i = 0; i < 2; ++i)
+  {
+    Side& side = sides[i];
+    side.X0 = i * ViewportWidth;
+    vtkOpenGLRenderer* renderer = side.Renderer;
+    renderer->SetViewport(0.5 * i, 0.0, 0.5 * (i + 1), 1.0);
+    renderer->SetUpdateLightingUniformsEveryRender(everyRender);
+
+    // The same kind of mapper and the same kind of light in both renderers,
+    // so that both draw with one shader program.
+    vtkNew<vtkPolyDataMapper> mapper;
+    mapper->SetInputConnection(sphere->GetOutputPort());
+    vtkNew<vtkActor> actor;
+    actor->SetMapper(mapper);
+    renderer->AddActor(actor);
+
+    side.Light->SetLightTypeToSceneLight();
+    side.Light->PositionalOff();
+    side.Light->SetPosition(i == 0 ? -1.0 : 1.0, 0.0, 0.0);
+    side.Light->SetFocalPoint(0.0, 0.0, 0.0);
+    renderer->AddLight(side.Light);
+
+    vtkNew<vtkCamera> camera;
+    camera->SetPosition(0.0, 0.0, 3.0);
+    camera->SetFocalPoint(0.0, 0.0, 0.0);
+    renderer->SetActiveCamera(camera);
+
+    window->AddRenderer(renderer);
+  }
+
+  // Each renderer alone. Its light is modified first, so that it sets its
+  // light uniforms whatever the other renderer set before.
+  vtkNew<vtkUnsignedCharArray> alone[2];
+  for (int i = 0; i < 2; ++i)
+  {
+    sides[i].Renderer->DrawOn();
+    sides[1 - i].Renderer->DrawOff();
+    sides[i].Light->Modified();
+    window->Render();
+    ReadViewport(window, sides[i], alone[i]);
+  }
+
+  // The left sphere is lit from the left, the right one from the right.
+  const bool litFromLeft[2] = { true, false };
+  for (int i = 0; i < 2; ++i)
+  {
+    const double left = MeanBrightness(alone[i], true);
+    const double right = MeanBrightness(alone[i], false);
+    if ((left > right + 10.0) != litFromLeft[i])
+    {
+      std::cerr << "Renderer " << i << " alone: mean brightness " << left << " on the left, "
+                << right << " on the right; expected it lit from the "
+                << (litFromLeft[i] ? "left" : "right") << ".\n";
+      return false;
+    }
+  }
+
+  // Both renderers, for a few renders.
+  sides[0].Renderer->DrawOn();
+  sides[1].Renderer->DrawOn();
+  bool same = true;
+  for (int render = 0; render < 3; ++render)
+  {
+    window->Render();
+    for (int i = 0; i < 2; ++i)
+    {
+      vtkNew<vtkUnsignedCharArray> both;
+      ReadViewport(window, sides[i], both);
+      const int different = CountDifferentPixels(alone[i], both);
+      if (different > 0)
+      {
+        std::cerr << "Render " << render << " with both renderers: " << different
+                  << " pixels of renderer " << i << " differ from its render alone.\n";
+        same = false;
+      }
+    }
+  }
+  return same;
+}
+}
+
+int TestLightingUniformsEveryRender(int, char*[])
+{
+  return DrawAsAlone(true) ? EXIT_SUCCESS : EXIT_FAILURE;
+}
diff --git a/Rendering/OpenGL2/vtkOpenGLRenderer.cxx b/Rendering/OpenGL2/vtkOpenGLRenderer.cxx
index dbdbcc2..90d0cd3 100644
--- a/Rendering/OpenGL2/vtkOpenGLRenderer.cxx
+++ b/Rendering/OpenGL2/vtkOpenGLRenderer.cxx
@@ -83,6 +83,7 @@ vtkOpenGLRenderer::vtkOpenGLRenderer()
 
   this->LightingCount = -1;
   this->LightingComplexity = -1;
+  this->UpdateLightingUniformsEveryRender = 0;
 
   this->UseSphericalHarmonics = true;
 
@@ -294,6 +295,18 @@ int vtkOpenGLRenderer::UpdateLights()
 
   this->LightingUpdateTime = ltime;
 
+  if (this->UpdateLightingUniformsEveryRender)
+  {
+    // Another renderer of this window may have set its own light uniforms in
+    // a shader program since this renderer last drew with it, and the program
+    // does not record which renderer set them. Count the lights as modified
+    // now, so that UpdateLightingUniforms() sets them again in each program,
+    // once in this render.
+    vtkTimeStamp now;
+    now.Modified();
+    this->LightingUpdateTime = now.GetMTime();
+  }
+
   return this->LightingCount;
 }
 
@@ -722,6 +735,8 @@ void vtkOpenGLRenderer::DeviceRenderTranslucentPolygonalGeometry(vtkFrameBufferO
 void vtkOpenGLRenderer::PrintSelf(ostream& os, vtkIndent indent)
 {
   this->Superclass::PrintSelf(os, indent);
+  os << indent << "UpdateLightingUniformsEveryRender: "
+     << (this->UpdateLightingUniformsEveryRender ? "On" : "Off") << "\n";
 }
 
