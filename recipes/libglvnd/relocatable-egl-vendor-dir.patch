+/*
+ * cvcpkg: relocatable default vendor directory.
+ *
+ * DEFAULT_EGL_VENDOR_CONFIG_DIRS is baked at configure time as an absolute
+ * path under the build prefix, which does not exist once a cvcpkg bundle is
+ * installed into a different prefix.  Also search
+ * "<dir of libEGL.so>/../share/glvnd/egl_vendor.d", derived at run time via
+ * dladdr(), so a vendor ICD installed in the same prefix (e.g. cvcpkg's
+ * mesa -> 50_mesa.json) is found from any prefix location with no
+ * environment variables.  Searched FIRST so it wins over the baked
+ * defaults; __EGL_VENDOR_LIBRARY_FILENAMES / __EGL_VENDOR_LIBRARY_DIRS
+ * still take precedence over everything.
+ */
+static char *BuildRelocatableVendorDirs(void)
+{
+    Dl_info info;
+    char *libdir, *slash, *result = NULL;
+    size_t len;
+
+    if (dladdr((void *) &BuildRelocatableVendorDirs, &info) == 0
+            || info.dli_fname == NULL) {
+        return NULL;
+    }
+    libdir = strdup(info.dli_fname);
+    if (libdir == NULL) {
+        return NULL;
+    }
+    slash = strrchr(libdir, '/');
+    if (slash == NULL) {
+        free(libdir);
+        return NULL;
+    }
+    *slash = '\0';
+    len = strlen(libdir);
+    // Only a directory (not "libEGL.so.1" alone) can be resolved.
+    if (len == 0) {
+        free(libdir);
+        return NULL;
+    }
+    if (glvnd_asprintf(&result, "%s/../share/glvnd/egl_vendor.d:%s",
+                       libdir, DEFAULT_EGL_VENDOR_CONFIG_DIRS) <= 0) {
+        result = NULL;
+    }
+    free(libdir);
+    return result;
+}
